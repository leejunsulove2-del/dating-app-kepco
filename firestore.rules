rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Users Collection - readable and writable for permanent cloud sync across all devices
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Admin Accounts (Master & Agency Managers)
    match /admin_accounts/{adminId} {
      allow read, write: if true;
    }

    // 3. Admin Communication Board
    match /admin_board/{boardId} {
      allow read, write: if true;
    }

    // 4. Admin Audit Logs
    match /admin_logs/{logId} {
      allow read, write: if true;
    }

    // 5. User Item Inventories
    match /user_inventories/{userId} {
      allow read, write: if true;
    }

    // 6. Match actions & likes
    match /likes/{likeId} {
      allow read, write: if true;
    }

    // 7. Allowed Domains Whitelist
    match /allowed_domains/{domainId} {
      allow read, write: if true;
    }

    // 8. Chat Rooms and Nested Messages
    match /chat_rooms/{roomId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 9. Reports
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // 10. Pending Registrations
    match /pending_registrations/{regId} {
      allow read, write: if true;
    }

  }
}
