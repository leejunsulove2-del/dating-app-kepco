# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Firebase Realtime Database & Auth (Client-side)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=dating-app-kepco.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://dating-app-kepco-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=dating-app-kepco
VITE_FIREBASE_STORAGE_BUCKET=dating-app-kepco.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=420973603361
VITE_FIREBASE_APP_ID=1:420973603361:web:dc059dfc3ad10fd8bf1160
VITE_FIREBASE_MEASUREMENT_ID=G-2CJB9ZRMRN

# Master Admin Password (KEPCO Admin)
# Injected via GitHub Repository Secrets or Environment Variable
ADMIN_PASSWORD=
VITE_ADMIN_PASSWORD=

